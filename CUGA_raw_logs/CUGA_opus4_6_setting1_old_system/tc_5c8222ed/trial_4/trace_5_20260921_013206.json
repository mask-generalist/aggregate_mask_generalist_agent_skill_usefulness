              "name": "code",
              "value": "import re\n\nlines = csv_content.replace('\\r\\n', '\\n').strip().split('\\n')\nheader = lines[0]\ntarget_ids = {\"D001\", \"D003\", \"D006\"}\n\nmatched_deals = []\nfor line in lines[1:]:\n    fields = line.split(',')\n    deal_id = fields[0]\n    if deal_id in target_ids:\n        matched_deals.append({\n            \"deal_id\": fields[0],\n            \"rep_name\": fields[1],\n            \"region\": fields[2],\n            \"product\": fields[3],\n            \"amount\": int(fields[4]),\n            \"close_date\": fields[5],\n            \"status\": fields[6],\n        })\n\n# Build formatted summary\ntotal_amount = sum(d[\"amount\"] for d in matched_deals)\n\nsummary = []\nsummary.append(\"=\" * 65)\nsummary.append(\"  JAMES OKAFOR \u2014 WON DEALS SUMMARY (D001, D003, D006)\")\nsummary.append(\"=\" * 65)\nsummary.append(\"\")\nsummary.append(f\"  {'Deal ID':<10}{'Region':<10}{'Product':<25}{'Amount':>10}  {'Close Date'}\")\nsummary.append(f\"  {'-'*8:<10}{'-'*8:<10}{'-'*23:<25}{'-'*10:>10}  {'-'*10}\")\n\nfor d in matched_deals:\n    summary.append(f\"  {d['deal_id']:<10}{d['region']:<10}{d['product']:<25}${d['amount']:>9,}  {d['close_date']}\")\n\nsummary.append(\"\")\nsummary.append(f\"  {'TOTAL':.<45}${total_amount:>9,}\")\nsummary.append(f\"  {'DEAL COUNT':.<45}{len(matched_deals):>10}\")\nsummary.append(\"\")\nsummary.append(\"=\" * 65)\n\nreport = '\\n'.join(summary)\nprint(report)",
