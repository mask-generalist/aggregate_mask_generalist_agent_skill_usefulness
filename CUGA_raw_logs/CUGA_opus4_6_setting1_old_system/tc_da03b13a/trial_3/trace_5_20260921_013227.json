              "name": "code",
              "value": "# Parse the CSV properly, stripping \\r characters\nlines = csv_content.replace('\\r', '').strip().split('\\n')\nheader_fields = lines[0].split(',')\n\nwon_deals = []\ntotal_value = 0\nfor line in lines[1:]:\n    fields = line.split(',')\n    status = fields[6].strip().lower()\n    if status == 'won':\n        deal = {\n            'deal_id': fields[0],\n            'rep_name': fields[1],\n            'region': fields[2],\n            'product': fields[3],\n            'amount': int(fields[4]),\n            'close_date': fields[5],\n        }\n        won_deals.append(deal)\n        total_value += deal['amount']\n\n# Display results\nprint(f\"{'Deal ID':<10} {'Rep':<20} {'Region':<8} {'Product':<25} {'Amount':>10} {'Close Date':<12}\")\nprint(\"-\" * 90)\nfor d in won_deals:\n    print(f\"{d['deal_id']:<10} {d['rep_name']:<20} {d['region']:<8} {d['product']:<25} {d['amount']:>10,} {d['close_date']:<12}\")\nprint(\"-\" * 90)\nprint(f\"{'TOTAL WON':.<65} ${total_value:>10,}\")\nprint(f\"\\nTotal won deals: {len(won_deals)}\")",
              "check": null
            }
