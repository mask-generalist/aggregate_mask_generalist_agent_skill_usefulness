            {
              "name": "code",
              "value": "import re\n\n# The excel_raw output format is: (row, col): value\\t(row, col): value\\t per line\n# Parse all (row, col): value entries from the raw output\nall_cells = re.findall(r'\\((\\d+),\\s*(\\d+)\\):\\s*([^\\t\\n]+)', excel_raw)\n\n# Build a dict: row -> {col -> value}\ndata = {}\nfor r, c, v in all_cells:\n    r, c = int(r), int(c)\n    if r not in data:\n        data[r] = {}\n    data[r][c] = v.strip()\n\n# Headers from row 1\nheaders = data.get(1, {})\n# Order ORD-6C71B1 is in row 2\norder_data = data.get(2, {})\n\nprint(\"=== Order ORD-6C71B1 \u2014 Summary ===\\n\")\nfor col in sorted(headers.keys()):\n    h = headers[col]\n    v = order_data.get(col, 'N/A')\n    print(f\"  {h}: {v}\")",
              "check": null
            }
          ],
