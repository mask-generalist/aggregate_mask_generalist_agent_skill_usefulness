              "value": "import re\n\n# Re-parse from csv_content, handling \\r\\n line endings\nlines = csv_content.strip().split('\\n')\nheader = [h.strip() for h in lines[0].split(',')]\n\n# Columns: deal_id(0), rep_name(1), region(2), product(3), amount(4), close_date(5), status(6)\ntotal_value = 0.0\nwon_deals = []\n\nfor line in lines[1:]:\n    if not line.strip():\n        continue\n    fields = [f.strip() for f in line.split(',')]\n    deal_id = fields[0]\n    rep = fields[1]\n    product = fields[3]\n    amount = float(fields[4])\n    status = fields[6].strip()\n    \n    if status.lower() == 'won':\n        total_value += amount\n        won_deals.append({\n            'deal_id': deal_id,\n            'rep': rep,\n            'product': product,\n            'amount': amount\n        })\n\nprint(f\"Meridian Analytics \u2014 Won Deals in Q3:\\n\")\nprint(f\"{'Deal ID':<10} {'Rep':<20} {'Product':<25} {'Amount':>12}\")\nprint(\"-\" * 70)\nfor d in won_deals:\n    print(f\"{d['deal_id']:<10} {d['rep']:<20} {d['product']:<25} ${d['amount']:>11,.2f}\")\nprint(\"-\" * 70)\nprint(f\"{'TOTAL':<55} ${total_value:>11,.2f}\")\nprint(f\"\\nTotal won deals: {len(won_deals)}\")",
