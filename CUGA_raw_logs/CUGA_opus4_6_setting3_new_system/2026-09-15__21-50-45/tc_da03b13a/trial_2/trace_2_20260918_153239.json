            {
              "name": "code",
              "value": "import re\n\n# Parse the CSV data\nlines = sales_data.strip().split('\\n')\nheader = lines[0].split(',')\nprint(f\"Columns: {header}\")\n\n# Filter for Meridian Analytics + New Business + Won\nmeridian_new_won = []\nfor line in lines[1:]:\n    fields = line.split(',')\n    client = fields[1]\n    deal_type = fields[2]\n    stage = fields[3]\n    amount = int(fields[4])\n    deal_id = fields[0]\n    \n    if client == \"Meridian Analytics\" and deal_type == \"New Business\" and stage == \"Won\":\n        meridian_new_won.append({\"deal_id\": deal_id, \"amount\": amount, \"close_date\": fields[5], \"rep\": fields[6]})\n\ntotal_new_contract_value = sum(d[\"amount\"] for d in meridian_new_won)\n\nprint(f\"\\nMeridian Analytics \u2014 Won 'New Business' deals:\")\nfor d in meridian_new_won:\n    print(f\"  {d['deal_id']}: ${d['amount']:,} (closed {d['close_date']}, rep: {d['rep']})\")\nprint(f\"\\nTotal new contract value (won): ${total_new_contract_value:,}\")",
              "check": null
            }
