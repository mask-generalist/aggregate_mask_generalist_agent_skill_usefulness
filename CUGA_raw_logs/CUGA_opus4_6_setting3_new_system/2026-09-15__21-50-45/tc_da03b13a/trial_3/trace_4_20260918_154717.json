              "value": "import re\n\n# all_rows already has the 22 parsed deal dicts \u2014 filter for status == 'won'\nwon_deals = [r for r in all_rows if r['status'].strip().lower() == 'won']\n\n# Sum amounts\ncalculated_total = 0.0\nfor deal in won_deals:\n    amt = float(re.sub(r'[^\\d.]', '', deal['amount']))\n    calculated_total += amt\n\nprint(f\"Won deals count: {len(won_deals)}\")\nprint(f\"Won deal IDs & amounts:\")\nfor d in won_deals:\n    print(f\"  {d['deal_id']}  {d['rep_name']:<18} {d['product']:<25} ${float(d['amount']):>10,.0f}\")\n\nprint(f\"\\nCalculated total (won deals): ${calculated_total:,.2f}\")\n\n# Report states $1,040,000\nreport_figure = 1_040_000\ndifference = calculated_total - report_figure\nprint(f\"Report figure:                ${report_figure:,.2f}\")\nprint(f\"Difference:                   ${difference:,.2f}\")\n\nif difference == 0:\n    print(\"\\n\u2705 The report figure matches the CSV data exactly. No update needed.\")\nelse:\n    print(f\"\\n\u26a0\ufe0f  DISCREPANCY: The report is off by ${abs(difference):,.2f}.\")\n    if difference < 0:\n        print(f\"   The report OVERSTATES the total by ${abs(difference):,.2f}.\")\n    else:\n        print(f\"   The report UNDERSTATES the total by ${abs(difference):,.2f}.\")\n    print(f\"   The report should be updated from $1,040,000 to ${calculated_total:,.0f}.\")",
