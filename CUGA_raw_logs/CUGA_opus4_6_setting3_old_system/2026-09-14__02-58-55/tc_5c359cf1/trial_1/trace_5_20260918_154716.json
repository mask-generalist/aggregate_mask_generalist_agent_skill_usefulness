              "value": "import re\n\n# The report content is in the 'report' variable\n# Extract the Executive Summary section\nlines = report.split('\\n')\nexec_summary_lines = []\nin_summary = False\n\nfor line in lines:\n    # Detect start of Executive Summary\n    if re.match(r'^##\\s+Executive Summary', line):\n        in_summary = True\n        exec_summary_lines.append(line)\n        continue\n    # Detect next section heading (## level) which ends the summary\n    if in_summary and re.match(r'^##\\s+', line):\n        break\n    if in_summary:\n        exec_summary_lines.append(line)\n\nexecutive_summary = '\\n'.join(exec_summary_lines).strip()\nprint(f\"Extracted executive summary ({len(executive_summary)} chars):\")\nprint(executive_summary)",
