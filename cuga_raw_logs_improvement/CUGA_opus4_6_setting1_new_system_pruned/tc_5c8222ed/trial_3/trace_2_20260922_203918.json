              "value": "# Fix: strip \\r from all fields when parsing\nlines = sales_content.replace('\\r\\n', '\\n').strip().split('\\n')\nheader_line = lines[0]\n\ntarget_deals = {\"D001\", \"D003\", \"D006\"}\njames_won_deals = []\n\nfor line in lines[1:]:\n    fields = [f.strip() for f in line.split(',')]\n    if len(fields) >= 7:\n        did, rep, region, product, amount, close_date, status = fields\n        if rep == \"James Okafor\" and status == \"won\":\n            james_won_deals.append(fields)\n\nprint(f\"Header: {header_line}\\n\")\nprint(f\"James Okafor's Won deals ({len(james_won_deals)} found):\\n\")\nprint(f\"{'Deal ID':<10} {'Region':<8} {'Product':<25} {'Amount':>10} {'Close Date':<12} {'Status'}\")\nprint(\"-\" * 80)\nfor d in james_won_deals:\n    print(f\"{d[0]:<10} {d[2]:<8} {d[3]:<25} ${int(d[4]):>9,} {d[5]:<12} {d[6]}\")\n\nfound_ids = {d[0] for d in james_won_deals}\nmissing = target_deals - found_ids\nif missing:\n    print(f\"\\n\u26a0\ufe0f Missing target deals: {missing}\")\nelse:\n    print(f\"\\n\u2705 All target deals (D001, D003, D006) confirmed present.\")\n\ntotal_value = sum(int(d[4]) for d in james_won_deals)\nprint(f\"\\nTotal won deal value for James Okafor: ${total_value:,}\")",
