# Ignore file for docker-pi/Dockerfile (BuildKit reads <dockerfile>.dockerignore next to it).
# Paths are relative to the BUILD CONTEXT ROOT (the repo root), since that is the context.
# Keeps the builder's `COPY . .` from dragging in huge/stale/host-specific trees.

# Dependencies — reinstalled fresh via `npm ci` in the builder.
node_modules
**/node_modules

# Build outputs — recompiled in the builder from source.
**/dist
.artifacts

# VCS and local tooling.
.git
.github
.husky

# The docker-pi tooling itself is not needed inside the image build — except models.json,
# which the runtime stage COPYs in. Exclude the dir's *contents* (not the dir itself) so the
# negation reliably re-includes the one file across BuildKit versions.
docker-pi/*
!docker-pi/models.json

# Editor / OS cruft.
.DS_Store
*.log
