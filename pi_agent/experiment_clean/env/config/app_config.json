{
  "app_name": "Meridian Analytics Platform",
  "version": "2.4.1",
  "environment": "production",
  "database": {
    "host": "db.internal.meridiananalytics.io",
    "port": 5432,
    "name": "meridian_prod",
    "pool_size": 10,
    "ssl": true
  },
  "cache": {
    "host": "redis.internal.meridiananalytics.io",
    "port": 6379,
    "ttl_seconds": 3600
  },
  "features": {
    "enable_analytics": true,
    "enable_export_pdf": true,
    "enable_api_access": true,
    "enable_sso": true,
    "enable_custom_dashboards": true,
    "beta_ai_summaries": false
  },
  "notifications": {
    "slack_webhook": "https://hooks.slack.com/services/T00MERIDIAN/B00MERIDIAN/xxxxxxxxxxxxxxxxxxxx",
    "email_list": [
      "r.kim@meridiananalytics.io",
      "p.nair@meridiananalytics.io",
      "c.fontaine@meridiananalytics.io"
    ],
    "alert_on_critical_tickets": true
  },
  "data_paths": {
    "sales": "data/sales_q3.csv",
    "employees": "data/employees.json",
    "inventory": "data/inventory.csv",
    "expenses": "data/expenses_q3.json",
    "tickets": "data/support_tickets.csv"
  },
  "logging": {
    "level": "INFO",
    "output": "stdout",
    "structured": true
  }
}