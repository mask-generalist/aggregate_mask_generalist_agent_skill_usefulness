              "name": "code",
              "value": "import re\n\n# Parse the CSV content (already in csv_content)\nlines = csv_content.strip().replace('\\r\\n', '\\n').split('\\n')\nheader = lines[0].split(',')\nprint(f\"Columns: {header}\\n\")\n\n# Parse all rows\nall_deals = []\nwon_deals = []\ntotal_won_value = 0\n\nfor line in lines[1:]:\n    if not line.strip():\n        continue\n    fields = line.split(',')\n    deal = dict(zip(header, fields))\n    all_deals.append(deal)\n    if deal['status'].strip().lower() == 'won':\n        amount = int(deal['amount'])\n        total_won_value += amount\n        won_deals.append(deal)\n\n# Summary\nprint(f\"Total deals in Q3: {len(all_deals)}\")\nprint(f\"  - Won:     {len(won_deals)}\")\nprint(f\"  - Lost:    {len([d for d in all_deals if d['status'].strip().lower() == 'lost'])}\")\nprint(f\"  - Pending: {len([d for d in all_deals if d['status'].strip().lower() == 'pending'])}\")\nprint()\n\n# Won deals breakdown\nprint(\"=\" * 70)\nprint(f\"{'Deal ID':<8} {'Rep':<20} {'Region':<8} {'Product':<25} {'Amount':>10}\")\nprint(\"-\" * 70)\nfor d in won_deals:\n    print(f\"{d['deal_id']:<8} {d['rep_name']:<20} {d['region']:<8} {d['product']:<25} ${int(d['amount']):>9,}\")\nprint(\"-\" * 70)\nprint(f\"{'TOTAL NEW CONTRACT VALUE (Won Deals)':>61}  ${total_won_value:>9,}\")\nprint(\"=\" * 70)\n\n# Breakdown by product\nproduct_totals = {}\nfor d in won_deals:\n    prod = d['product']\n    product_totals[prod] = product_totals.get(prod, 0) + int(d['amount'])\n\nprint(\"\\nBreakdown by Product:\")\nfor prod, total in sorted(product_totals.items(), key=lambda x: -x[1]):\n    print(f\"  {prod:<25} ${total:>10,}\")\n\n# Breakdown by rep\nrep_totals = {}\nfor d in won_deals:\n    rep = d['rep_name']\n    rep_totals[rep] = rep_totals.get(rep, 0) + int(d['amount'])\n\nprint(\"\\nBreakdown by Sales Rep:\")\nfor rep, total in sorted(rep_totals.items(), key=lambda x: -x[1]):\n    print(f\"  {rep:<20} ${total:>10,}\")",
