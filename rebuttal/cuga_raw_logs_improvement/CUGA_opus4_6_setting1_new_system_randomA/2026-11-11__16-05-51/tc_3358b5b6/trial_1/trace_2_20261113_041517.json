on)} Won Deals (${sofia_total:,})\")\nparts.append(\"\")\nparts.append(\"| Deal ID | Amount | Close Date |\")\nparts.append(\"|---------|--------|------------|\")\nfor d in sofia_won:\n    parts.append(f\"| {d['id']} | ${d['amount']:,} | {d['date']} |\")\nparts.append(\"\")\nparts.append(f\"**Subtotal: ${sofia_total:,}**\")\nparts.append(\"\")\nparts.append(\"---\")\nparts.append(\"\")\nparts.append(\"*Generated from Q3 2026 sales data.*\")\n\nmd_content = '\\n'.join(parts)\nprint(md_content)",
