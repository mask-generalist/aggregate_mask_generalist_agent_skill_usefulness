            {
              "name": "code",
              "value": "# Parse the CSV data (handle \\r\\n line endings)\nrows = sales_csv.strip().replace('\\r\\n', '\\n').split('\\n')\nheader = rows[0].split(',')\nprint(f\"Columns: {header}\")\nprint(f\"Total rows: {len(rows) - 1}\\n\")\n\ntarget_deals = {'D001', 'D002', 'D003', 'D005', 'D006', 'D008'}\ntarget_reps = {'James Okafor', 'Sofia Delgado'}\n\n# Column indices\nid_i = header.index('deal_id')\nrep_i = header.index('rep_name')\namount_i = header.index('amount')\nclose_i = header.index('close_date')\nstatus_i = header.index('status')\n\nprint(\"Won Deals for James Okafor & Sofia Delgado (D001, D002, D003, D005, D006, D008):\\n\")\nprint(f\"{'Deal ID':<10} {'Rep Name':<20} {'Amount':>10} {'Close Date':<12} {'Status'}\")\nprint(\"-\" * 65)\n\nextracted = []\nfor row in rows[1:]:\n    fields = row.split(',')\n    did = fields[id_i].strip()\n    rep = fields[rep_i].strip()\n    amt = fields[amount_i].strip()\n    cdate = fields[close_i].strip()\n    st = fields[status_i].strip()\n    \n    if did in target_deals and rep in target_reps and st.lower() == 'won':\n        extracted.append({'deal_id': did, 'rep': rep, 'amount': int(amt), 'close_date': cdate, 'status': st})\n        print(f\"{did:<10} {rep:<20} ${int(amt):>9,} {cdate:<12} {st}\")\n\njames_total = sum(d['amount'] for d in extracted if d['rep'] == 'James Okafor')\nsofia_total = sum(d['amount'] for d in extracted if d['rep'] == 'Sofia Delgado')\ngrand_total = sum(d['amount'] for d in extracted)\n\nprint(f\"\\nJames Okafor total:  ${james_total:,} ({sum(1 for d in extracted if d['rep'] == 'James Okafor')} deals)\")\nprint(f\"Sofia Delgado total: ${sofia_total:,} ({sum(1 for d in extracted if d['rep'] == 'Sofia Delgado')} deals)\")\nprint(f\"Grand total:         ${grand_total:,} ({len(extracted)} deals)\")",
              "check": null
            }
          ],
